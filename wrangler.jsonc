{
  "name": "meeting-bingo",
  "main": "src/index.js",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  
  "durable_objects": {
    "bindings": [
      { "name": "BINGO_ROOM", "class_name": "BingoRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BingoRoom"] }
  ]
}
