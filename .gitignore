# Dependencies (reinstalled with `npm install`)
node_modules/

# Local dev secrets — never commit (use `wrangler secret put` for prod)
.dev.vars
.dev.vars.*
# …but DO track the template
!.dev.vars.example

# Private instance assets — deployed with `wrangler deploy`, never committed.
# (e.g. a custom default stamp image referenced by DEFAULT_STAMP_IMG)
public/stamps/

# Wrangler local state / build output
.wrangler/
dist/

# OS / editor cruft
.DS_Store
*.log
